# ── SSH jump host / server ────────────────────────────────────────────────
# The MCP server opens an SSH connection to this host and forwards a local
# random port to 127.0.0.1:<MCP_REMOTE_DB_PORT> on the remote side.
MCP_SSH_HOST=your.server.example.com
MCP_SSH_PORT=22
MCP_SSH_USER=deploy
# Path to an SSH private key. Never commit the key itself.
MCP_SSH_PEM=C:\Users\you\.ssh\id_ed25519

# ── MySQL (reached through the tunnel above) ──────────────────────────────
MCP_REMOTE_DB_PORT=3306
MCP_DB_USER=readonly_user
MCP_DB_PASSWORD=change-me
MCP_DB_NAME=your_database

# ── Limits ────────────────────────────────────────────────────────────────
MCP_MAX_ROWS=50

# ── Ops tools ─────────────────────────────────────────────────────────────
# Read-only ops (status / logs / inspect) register automatically.
# Anything that mutates state stays off unless you flip this to 1.
MCP_ENABLE_MUTATING_TOOLS=0
# Containers the ops tools are allowed to touch.
MCP_CONTAINERS=app-server,app-mysql,app-redis
# Used by deploy_check / deploy_backend_jar / deploy_frontend.
MCP_COMPOSE_DIR=/opt/app
MCP_BACKEND_SERVICE=server
MCP_REMOTE_JAR_PATH=/opt/app/backend/target/backend.jar
MCP_DISK_PATH=/opt
MCP_HEALTH_URL=http://localhost:48080/actuator/health
MCP_FRONTEND_TARGETS=admin=/opt/app/admin-ui,webroot=/opt/app/webroot
MCP_NGINX_RELOAD_CMD=docker exec app-nginx nginx -s reload
